{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jm-brun.github.io/society-lab/schemas/mechanism.schema.json",
  "title": "Society Lab Mechanism",
  "description": "Fiche descriptive d'un mécanisme explicatif. Son existence ne vaut pas validation causale.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "label", "description", "domain_ids", "status", "reviewed_at"],
  "properties": {
    "id": {"type": "string", "pattern": "^MECHANISM-[A-Z0-9][A-Z0-9-]*$"},
    "label": {"type": "string", "minLength": 1},
    "description": {"type": "string", "minLength": 20},
    "domain_ids": {"type": "array", "items": {"type": "string", "pattern": "^DOMAIN-[A-Z0-9-]+$"}, "minItems": 1, "uniqueItems": true},
    "direction": {"type": "string", "description": "Sens du canal décrit ; préciser les variables de départ et d'arrivée."},
    "stages": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1},
    "scope_conditions": {"type": "array", "items": {"type": "string"}},
    "actors": {"type": "array", "items": {"type": "string"}},
    "indicators": {"type": "array", "items": {"type": "string"}},
    "time_horizon": {"type": "string"},
    "supporting_study_ids": {"type": "array", "items": {"type": "string", "pattern": "^STUDY-[A-Z0-9-]+$"}, "minItems": 1, "uniqueItems": true},
    "challenging_study_ids": {"type": "array", "items": {"type": "string", "pattern": "^STUDY-[A-Z0-9-]+$"}, "minItems": 1, "uniqueItems": true},
    "claim_ids": {"type": "array", "items": {"type": "string", "pattern": "^CLAIM-[A-Z0-9-]+$"}, "minItems": 1, "uniqueItems": true},
    "alternative_explanations": {"type": "array", "items": {"type": "string"}},
    "limitations": {"type": "array", "items": {"type": "string"}},
    "status": {"enum": ["candidate", "theoretical", "descriptive", "supported_in_scope", "mixed_evidence", "challenged", "rejected_in_scope", "retired"]},
    "confidence_rationale": {"type": "string"},
    "reviewed_at": {"type": "string", "format": "date"},
    "tags": {"type": "array", "items": {"type": "string", "pattern": "^TAG-[A-Z0-9-]+$"}, "uniqueItems": true}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"enum": ["supported_in_scope", "mixed_evidence", "challenged", "rejected_in_scope"]}}, "required": ["status"]},
      "then": {"anyOf": [{"required": ["supporting_study_ids"]}, {"required": ["challenging_study_ids"]}, {"required": ["claim_ids"]}]}
    }
  ]
}

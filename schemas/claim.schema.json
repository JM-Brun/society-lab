{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jm-brun.github.io/society-lab/schemas/claim.schema.json",
  "title": "Society Lab Claim",
  "description": "A precise proposition examined by Society Lab. Confidence describes the current state of evidence, not the quality of any single source.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "statement", "claim_type", "status"],
  "properties": {
    "id": {"type": "string", "pattern": "^CLAIM-[A-Z0-9][A-Z0-9-]*$"},
    "statement": {"type": "string", "minLength": 10},
    "claim_type": {"enum": ["descriptive", "empirical", "causal", "interpretive", "normative", "predictive"]},
    "status": {"enum": ["unexamined", "under_review", "supported", "partially_supported", "contested", "not_supported", "insufficient_evidence", "superseded"]},
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "geography": {"type": "array", "items": {"type": "string"}},
        "population": {"type": "string"},
        "period": {"type": "string"},
        "conditions": {"type": "string"}
      }
    },
    "domain_ids": {"type": "array", "items": {"type": "string", "pattern": "^DOMAIN-[A-Z0-9-]+$"}, "uniqueItems": true},
    "source_ids": {"type": "array", "items": {"type": "string", "pattern": "^SOURCE-[A-Z0-9-]+$"}, "uniqueItems": true},
    "study_ids": {"type": "array", "items": {"type": "string", "pattern": "^STUDY-[A-Z0-9-]+$"}, "uniqueItems": true},
    "hypothesis_ids": {"type": "array", "items": {"type": "string", "pattern": "^HYPOTHESIS-[A-Z0-9-]+$"}, "uniqueItems": true},
    "tags": {"type": "array", "items": {"type": "string", "pattern": "^TAG-[A-Z0-9-]+$"}, "uniqueItems": true},
    "supporting_evidence": {"type": "array", "items": {"type": "string"}},
    "counter_evidence": {"type": "array", "items": {"type": "string"}},
    "best_counterargument": {"type": "string", "description": "The strongest fair version of the main opposing argument (steelman), not a token objection."},
    "assumptions": {"type": "array", "items": {"type": "string"}},
    "limitations": {"type": "array", "items": {"type": "string"}},
    "normative_criteria": {"type": "array", "items": {"type": "string"}, "description": "Values or criteria involved when the claim or its implications are normative."},
    "confidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["probability", "rationale"],
      "properties": {
        "probability": {"type": "number", "minimum": 0, "maximum": 1, "description": "Calibrated confidence in the proposition within its stated scope; do not use as a study-quality score."},
        "rationale": {"type": "string", "minLength": 10},
        "assessed_at": {"type": "string", "format": "date"}
      }
    },
    "source_verifications": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_id", "status"],
        "properties": {
          "source_id": {"type": "string", "pattern": "^SOURCE-[A-Z0-9][A-Z0-9-]*$"},
          "locator": {"type": "string", "description": "Page, table, figure, section, timestamp, dataset field or stable URL fragment."},
          "status": {"enum": ["not_checked", "ai_extracted", "source_checked", "independently_reviewed", "not_located", "not_applicable"]},
          "checked_at": {"type": "string", "format": "date"},
          "review_note": {"type": "string"}
        }
      }
    },
    "provenance": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["origin"],
        "properties": {
          "origin": {"enum": ["human_authored", "source_extracted", "ai_suggested", "analysis_derived", "imported"]},
          "note": {"type": "string"},
          "recorded_at": {"type": "string", "format": "date"}
        }
      }
    },
    "revision_triggers": {"type": "array", "items": {"type": "string"}},
    "revision_history": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["date", "reason"],
        "properties": {
          "date": {"type": "string", "format": "date"},
          "reason": {"type": "string"},
          "previous_status": {"type": "string"},
          "new_status": {"type": "string"},
          "previous_confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "new_confidence": {"type": "number", "minimum": 0, "maximum": 1}
        }
      }
    },
    "last_reviewed": {"type": "string", "format": "date"}
  }
}
